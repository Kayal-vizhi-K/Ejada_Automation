{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript framework: SauceDemo UI tests (POM) and Simple Books API tests, Allure reporting",
  "private": true,
  "scripts": {
    "install:browsers": "playwright install --with-deps chromium firefox",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox",
    "test:chrome": "playwright test --project=ui-chromium",
    "test:firefox": "playwright test --project=ui-firefox",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "clean": "node -e \"['allure-results','allure-report','playwright-report','test-results'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.20.5",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.6",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
